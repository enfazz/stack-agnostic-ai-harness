{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(**)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(uv run *)",
      "Bash(uv sync)",
      "Bash(poetry run *)",
      "Bash(pytest *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(cargo *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(glab mr *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*service-account*.json)",
      "Read(**/secrets/**)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*service-account*.json)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(gcloud * deploy*)",
      "Bash(kubectl delete*)",
      "Edit(**/.harness/guard-overrides.conf)",
      "Write(**/.harness/guard-overrides.conf)",
      "Bash(gh pr merge*)",
      "Bash(glab mr merge*)"
    ]
  }
}
